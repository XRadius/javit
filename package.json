{
  "main": "index.js",
  "name": "javit",
  "repository": "https://github.com/XRadius/javit",
  "type": "module",
  "bin": {
    "javit": "./bin/cli.js"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "sanitize-filename": "1.6.4",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "eslint": "9.37.0",
    "eslint-config-porcupine": "0.1.5",
    "prettier": "3.9.9",
    "prettier-plugin-jsdoc": "1.8.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">= 24.0.0",
    "npm": ">= 10.0.0"
  },
  "scripts": {
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint:check": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix",
    "prepack": "tsc index.js --allowJs --declaration --emitDeclarationOnly --removeComments --strict --skipLibCheck",
    "test": "npm run types:check && npm run lint:check && npm run format:check && node --test",
    "types:check": "tsc --project jsconfig.json",
    "types:watch": "tsc --project jsconfig.json --watch"
  }
}
